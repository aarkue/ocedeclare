{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "fullscreen": false,
        "height": 1000,
        "resizable": true,
        "title": "OCPQ (App)",
        "width": 1400,
        "useHttpsScheme": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        "desktop-capability",
        "migrated",
        {
          "identifier": "wdio",
          "description": "WebDriver automation for the e2e suite.",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
