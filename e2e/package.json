{
  "name": "ocpq-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm test:order-management && pnpm test:p2p",
    "build:app": "cd ../tauri && pnpm tauri build --no-bundle --features wdio --config src-tauri/tauri.conf.test.json; git checkout -- src-tauri/gen/schemas",
    "test:order-management": "xvfb-run -a -s '-screen 0 1600x1200x24' wdio run wdio.tauri.conf.ts",
    "test:p2p": "xvfb-run -a -s '-screen 0 1600x1200x24' wdio run wdio.p2p.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/globals": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.30.0",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/types": "^9.31.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "webdriverio": "^9.30.0"
  }
}
